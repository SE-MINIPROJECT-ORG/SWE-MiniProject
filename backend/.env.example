# Copy this file to .env and adjust the values. Never commit the real .env file.
PORT=5000
DATABASE_URL=postgres://ems:ems_password@localhost:5432/ems
JWT_SECRET=replace-with-a-long-random-string
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=EMS <no-reply@ems.test>
# Requests per minute per IP (EVT-SR-007). Keep 100 and 10; raise only for load tests.
API_RATE_LIMIT=100
LOGIN_RATE_LIMIT=10
